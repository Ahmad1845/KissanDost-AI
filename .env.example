# ============================================================================
# KissanDost AI - Local & Production Environment Configuration (.env.example)
# ============================================================================

# Google Gemini Multimodal Vision & TTS API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# FastAPI & PostgreSQL + pgvector + Redis Configuration
APP_ENV=development
PORT=3000
FASTAPI_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kissandost
REDIS_URL=redis://localhost:6379/0

# JWT Authentication & Security
JWT_SECRET_KEY=kissandost-kp-agri-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Rate Limiting & Caching
RATE_LIMIT_PER_MINUTE=120
WEATHER_CACHE_TTL_SECONDS=300
