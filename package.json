{
  "name": "kissandost-ai",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "local": "node scripts/setup-local.mjs && tsx server.ts",
    "setup": "node scripts/setup-local.mjs",
    "doctor": "node scripts/setup-local.mjs --check-only",
    "build": "vite build && node scripts/build-vercel-api.mjs",
    "preview": "vite preview",
    "clean": "node -e \"import('fs').then(fs => { fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('server.js', { force: true }); })\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": ">=1.0.0",
    "@tailwindcss/vite": ">=4.0.0",
    "@vitejs/plugin-react": ">=4.3.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": ">=0.460.0",
    "motion": ">=12.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "vite": ">=6.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": ">=20.0.0",
    "@types/react": ">=19.0.0",
    "@types/react-dom": ">=19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": ">=0.24.0",
    "tailwindcss": ">=4.0.0",
    "tsx": ">=4.19.0",
    "typescript": ">=5.6.0"
  }
}
